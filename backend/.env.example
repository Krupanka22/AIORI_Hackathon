# Environment Configuration
# Copy this file to .env and fill in values

# Application
APP_NAME=AIORI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./database/aiori.db

# WSL2
WSL_DISTRO=Ubuntu-24.04
WSL_USER=root

# Networking
MININET_ENABLED=false
ZEEK_LOG_DIR=/var/log/zeek
PCAP_DIR=/tmp/aiori/pcap
NETWORK_INTERFACE=s1-eth0

# AI Model
ML_MODEL_DIR=./ml/models
SIMILARITY_THRESHOLD=0.75
ANOMALY_THRESHOLD=0.85
FEATURE_WINDOW_SECONDS=30

# Blockchain
BLOCKCHAIN_ENABLED=false
HLF_NETWORK_DIR=../blockchain/network
HLF_CHANNEL_NAME=aiori-channel
HLF_CHAINCODE_NAME=identity_audit

# WebSocket
WS_HEARTBEAT_INTERVAL=30
