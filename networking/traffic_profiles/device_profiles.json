{
  "profiles": {
    "cctv_camera": {
      "description": "Continuous video stream upload with periodic control commands",
      "traffic_pattern": "continuous",
      "protocols": {
        "tcp": 0.80,
        "udp": 0.20
      },
      "bandwidth_kbps": {
        "min": 1000,
        "max": 4000,
        "typical": 2000
      },
      "packet_size": {
        "min": 500,
        "max": 1400,
        "typical": 1200
      },
      "inter_arrival_ms": {
        "min": 1,
        "max": 50,
        "typical": 10
      },
      "upload_download_ratio": 5.0,
      "connection_duration_sec": {
        "min": 10,
        "max": 3600,
        "typical": 300
      },
      "iperf3": {
        "tcp": "-t {duration} -b 2M -l 1400",
        "udp": "-u -t {duration} -b 500K -l 1200"
      }
    },
